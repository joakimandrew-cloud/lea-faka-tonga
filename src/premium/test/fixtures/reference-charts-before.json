[{"id":"preposed","title":"Preposed Pronouns","description":"Subject markers that follow tense particles (naʻa, ʻoku, kuo, te).","tables":[{"headers":["","Singular","Dual","Plural"],"rows":[["1st excl.","ku / ou / u","ma","mau"],["1st incl.","–","ta","tau"],["2nd","ke","mo","mou"],["3rd","ne","na","nau"]]}],"notes":["ku: after naʻa (past)","ou: after ʻoku (present)","u: after kuo (perfect), te (future)"]},{"id":"postposed","title":"Postposed Pronouns","description":"Emphatic and object forms. Used for emphasis or after prepositions.","tables":[{"headers":["","Singular","Dual","Plural"],"rows":[["1st excl.","au","kimaua","kimautolu"],["1st incl.","–","kitaua","kitautolu"],["2nd","koe","kimoua","kimoutolu"],["3rd","ia","kinaua","kinautolu"]]}],"notes":[]},{"id":"definite","title":"Definite Possessives","description":"Used before nouns to show possession. ʻe-class is for things you control or produce; ho-class is for inherent or permanent things.","tables":[{"label":"ʻe-class","sublabel":"actions, thoughts, children, food, tools","headers":["","Singular","Dual","Plural"],"rows":[["1st excl.","ʻeku","ʻema","ʻemau"],["1st incl.","–","ʻeta","ʻetau"],["2nd","hoʻo","hoʻomo","hoʻomou"],["3rd","ʻene","ʻena","ʻenau"]]},{"label":"ho-class","sublabel":"body parts, relatives, house, land","headers":["","Singular","Dual","Plural"],"rows":[["1st excl.","hoku","homa","homau"],["1st incl.","–","hota","hotau"],["2nd","ho","homo","homou"],["3rd","hono","hona","honau"]]}],"notes":[]},{"id":"indefinite","title":"Indefinite Possessives","description":"Used with indefinite nouns: \"a ... of mine\" rather than \"my ...\"","tables":[{"label":"ʻe-class","headers":["","Singular","Plural"],"rows":[["1st excl.","haʻaku","haʻamau"],["1st incl.","–","haʻatau"],["2nd","haʻo","haʻamou"],["3rd","haʻane","haʻanau"]]},{"label":"ho-class","headers":["","Singular","Plural"],"rows":[["1st excl.","haku","hamau"],["1st incl.","–","hatau"],["2nd","hao","hamou"],["3rd","hano","hanau"]]}],"notes":["ʻa hai? whose? (ʻe-class)","ʻo hai? whose? (ho-class)"]},{"id":"postposed-poss","title":"Postposed Possessives","description":"Used after the noun: \"the book is mine\" rather than \"my book\"","tables":[{"label":"ʻe-class","headers":["","Singular","Plural"],"rows":[["1st excl.","ʻaʻaku","ʻaʻamau"],["1st incl.","–","ʻaʻatau"],["2nd","ʻaʻau","ʻaʻamou"],["3rd","ʻaʻana","ʻaʻanau"]]},{"label":"ho-class","headers":["","Singular","Plural"],"rows":[["1st excl.","ʻoʻoku","ʻoʻomau"],["1st incl.","–","ʻoʻotau"],["2nd","ʻoʻou","ʻoʻomou"],["3rd","ʻoʻona","ʻoʻonau"]]}],"notes":[]},{"id":"beneficiary","title":"Beneficiary Pronouns","description":"Express \"for someone\": who the action benefits.","tables":[{"label":"ʻe-class (maʻa + pronoun)","headers":["","Singular","Plural"],"rows":[["1st excl.","maʻaku","maʻamau"],["1st incl.","–","maʻatau"],["2nd","maʻau","maʻamou"],["3rd","maʻana","maʻanau"]]},{"label":"ho-class (moʻo + pronoun)","headers":["","Singular","Plural"],"rows":[["1st excl.","moʻoku","moʻomau"],["1st incl.","–","moʻotau"],["2nd","moʻou","moʻomou"],["3rd","moʻona","moʻonau"]]}],"notes":[]},{"id":"emotional","title":"Emotional Possessives","description":"Express pity or affection: \"my poor ...\" or \"my dear ...\"","tables":[{"headers":["Person","ʻe-class","ho-class"],"rows":[["1st sing.","siʻeku","siʻoku"],["2nd sing.","siʻo","siʻo"],["3rd sing.","siʻene","siʻono"],["1st excl. pl.","siʻemau","siʻomau"],["1st incl. pl.","siʻetau","siʻotau"],["2nd pl.","siʻomou","siʻomou"],["3rd pl.","siʻenau","siʻonau"]]}],"notes":["siʻa: emotional indefinite article (\"a poor/dear ...\")"]},{"id":"impersonal","title":"Impersonal Forms","description":"Generic \"one\" / \"oneself\" forms used for general statements.","tables":[{"headers":["Type","ʻe-class","ho-class"],"rows":[["Pronoun","kita","kita"],["Definite possessive","ʻete","hoto"],["Indefinite possessive","haʻate","hato"],["Postposed possessive","ʻaʻata","ʻoʻota"],["Beneficiary","maʻata","moʻota"]]}],"notes":[]}]
